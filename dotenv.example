# nginx
# Keep 127.0.0.1 when a reverse proxy runs on the same host.
# Use 0.0.0.0 when the reverse proxy is on another machine.
EXPOSE_HOST=127.0.0.1
EXPOSE_PORT=8090

# FPM
FPM_HOST=fpm
FPM_PORT=9000

# Database
BDD_USERNAME=fzco
BDD_NAME=fzco
BDD_PASSWORD=change_me

# Debug
DEBUG=false

# uFBT - do not change when using Docker
UFBT_PATH=/usr/local/fzoc/ufbt/

# Build cache
# Increment to invalidate all cached FAPs after a compiler/toolchain change.
FZOC_BUILD_ENGINE_VERSION=1

# Compilation retention
# FAP files, build metadata and request records are purged after this period.
FZOC_RETENTION_DAYS=30

# Worker
FZOC_TASK_INTERVAL=2
FZOC_MAINT_INTERVAL=3600
FZOC_FIRMWARE_SYNC_INTERVAL=3600
FZOC_FIRMWARE_VERSION_LIMIT=5

# Display timezone. Database timestamps remain stored in UTC.
FZOC_TIMEZONE=Europe/Paris

# Optional: increases the GitHub API rate limit for RogueMaster catalog sync.
# FZOC_GITHUB_TOKEN=

# Cloudflare Turnstile
IS_ACTIVE_CLOUDFLARE_TURNSTILE=false
CLOUDFLARE_TURNSTILE_SITEKEY=fake
CLOUDFLARE_TURNSTILE_SERVERKEY=fake

# Comma-separated words blocked in application name or repository URL.
# Leave empty to disable the filter.
BANNED_APPLICATION_WORDS=
